{
    "name": "ces2027robot",
    "version": "0.1.0",
    "private": true,
    "main": "dist/server/index",
    "types": "dist/server/index",
    "packageManager": "pnpm@10.28.2",
    "files": [
        "dist",
        "README.md"
    ],
    "dependencies": {
        "@ant-design/icons": "^6.3.4",
        "@google-cloud/speech": "^8.1.0",
        "@google-cloud/storage": "^7.16.0",
        "@google-cloud/vertexai": "^1.10.0",
        "@microsoft/teams-js": "^2.0.0",
        "@microsoft/teams.api": "^2.0.0",
        "@microsoft/teams.apps": "^2.0.0",
        "@microsoft/teams.cards": "^2.0.0",
        "@microsoft/teams.client": "^2.0.0",
        "@microsoft/teams.common": "^2.0.0",
        "@microsoft/teams.dev": "^2.0.0",
        "@microsoft/teams.graph": "^2.0.0",
        "@microsoft/teams.graph-endpoints": "^2.0.0",
        "@prisma/client": "^6.16.2",
        "antd": "^6.6.5",
        "express": "^5.1.0",
        "fast-xml-parser": "^5.11.1",
        "ffmpeg-static": "^5.3.0",
        "google-auth-library": "^9.15.1",
        "jszip": "^3.10.2",
        "multer": "^2.0.2",
        "pdf-parse": "^2.4.5",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.5.4",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^10.0.5",
        "dotenv": "^16.4.5",
        "env-cmd": "^11.0.0",
        "prisma": "^6.16.2",
        "rimraf": "^6.0.1",
        "tsup": "^8.4.0",
        "tsx": "^4.19.2",
        "typescript": "^5.4.5",
        "vite": "^6.2.0"
    },
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs pnpm dev",
        "clean": "rimraf ./dist",
        "dev": "env-cmd --silent -f env/.env.local concurrently -k -n server,app \"pnpm dev:server\" \"pnpm dev:app\"",
        "dev:server": "tsx watch src/server/index.ts",
        "dev:app": "vite --host 0.0.0.0 --port 53000",
        "db": "./db.sh",
        "db:generate": "prisma generate",
        "start": "node -r dotenv/config .",
        "build": "tsup && pnpm build:frontend",
        "build:frontend": "vite build --outDir dist/client --base=./"
    }
}