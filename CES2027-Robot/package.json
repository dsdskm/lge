{
    "name": "ces2027robot",
    "version": "0.1.0",
    "private": true,
    "main": "dist/server/index",
    "types": "dist/server/index",
    "packageManager": "pnpm@10.28.2",
    "files": [
        "dist",
        "README.md"
    ],
    "dependencies": {
        "@microsoft/teams-js": "^2.0.0",
        "@microsoft/teams.api": "^2.0.0",
        "@microsoft/teams.apps": "^2.0.0",
        "@microsoft/teams.cards": "^2.0.0",
        "@microsoft/teams.client": "^2.0.0",
        "@microsoft/teams.common": "^2.0.0",
        "@microsoft/teams.dev": "^2.0.0",
        "@microsoft/teams.graph": "^2.0.0",
        "@microsoft/teams.graph-endpoints": "^2.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.5.4",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^4.3.4",
        "dotenv": "^16.4.5",
        "env-cmd": "^11.0.0",
        "rimraf": "^6.0.1",
        "tsup": "^8.4.0",
        "tsx": "^4.19.2",
        "typescript": "^5.4.5",
        "vite": "^6.2.0"
    },
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs pnpm dev",
        "clean": "rimraf ./dist",
        "dev": "tsx watch src/server/index.ts",
        "start": "node -r dotenv/config .",
        "build": "tsup && pnpm build:frontend",
        "build:frontend": "vite build --outDir dist/client --base=/tabs/home"
    }
}