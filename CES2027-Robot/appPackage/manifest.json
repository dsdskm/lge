{
	"$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
	"version": "1.0.0",
	"manifestVersion": "1.30",
	"id": "${{TEAMS_APP_ID}}",
	"name": {
		"short": "CES2027-Robot",
		"full": ""
	},
	"developer": {
		"name": "Teams App, Inc.",
		"mpnId": "",
		"websiteUrl": "https://www.example.com",
		"privacyUrl": "https://www.example.com/termofuse",
		"termsOfUseUrl": "https://www.example.com/privacy"
	},
	"description": {
		"short": "Short description",
		"full": "Full description"
	},
	"icons": {
		"outline": "outline.png",
		"color": "color.png"
	},
	"accentColor": "#FFFFFF",
	"validDomains": [
		"${{TAB_DOMAIN}}"
	],
	"bots": [],
	"composeExtensions": [],
	"staticTabs": [
		{
			"entityId": "index0",
			"name": "Home",
			"contentUrl": "${{TAB_ENDPOINT}}/tabs/home",
			"websiteUrl": "${{TAB_ENDPOINT}}/tabs/home",
			"scopes": [
				"personal",
				"groupChat",
				"team"
			]
		}
	],
	"permissions": [
		"identity",
		"messageTeamMembers"
	],
	"supportsChannelFeatures": "tier1"
}